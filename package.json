{
  "name": "sotalive-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "pnpm run build:dist",
    "build:apps": "turbo run build --filter=@sotalive/logconv --filter=@sotalive/fle --filter=@sotalive/myact",
    "build:dist": "pnpm run build:apps && scripts/assemble.sh",
    "lint": "turbo lint",
    "lint:apps": "pnpm --filter @sotalive/fle --filter @sotalive/logconv --filter @sotalive/myact run lint",
    "test": "pnpm --filter @sotalive/fle --filter @sotalive/logconv --filter @sotalive/myact exec vitest run --passWithNoTests",
    "clean": "rm -rf dist node_modules .turbo",
    "typecheck": "turbo typecheck",
    "pages:dev": "pnpm run build && wrangler pages dev dist --port 8788",
    "pages:deploy": "pnpm run build && wrangler pages deploy dist --branch main",
    "pages:deploy:preview": "pnpm run build && wrangler pages deploy dist --branch develop"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "turbo": "^2",
    "wrangler": "^4"
  }
}
