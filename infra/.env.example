# infra/.env.example — OpenTofu(infra/)に渡す秘密情報の雛形
#
# 使い方:
#   cp infra/.env.example infra/.env     # infra/.env は .gitignore 済み。コミットしない
#   infra/.env の値を埋める
#   source infra/.env && tofu -chdir=infra plan
#
# 運用の約束:
#   - 値は、会話(Claude Code など)に貼らない。このファイルにも本物の値を書かない(.example は空欄のまま)
#   - tofu は、人が自分のターミナルで走らせ、plan の出力だけを共有する(plan に秘密は出ない)
#   - 漏れたら、下の発行場所でトークンを削除(Roll / Delete)して作り直す

# ---------------------------------------------------------------------------
# 1. Cloudflare アカウント ID(秘密ではないが、リポジトリには書かない)
#    取り方: ダッシュボード → 左メニュー「Workers & Pages」(または任意のゾーンの概要)→
#            右側の「Account ID」の横のコピー。または `npx wrangler whoami` の表
# ---------------------------------------------------------------------------
export TF_VAR_cloudflare_account_id=""

# ---------------------------------------------------------------------------
# 2. Cloudflare API トークン(Pages・KV・DNS を tofu が操作する)
#    取り方: ダッシュボード右上のアイコン → My Profile → API Tokens → Create Token →
#            「Create Custom Token」の Get started
#      名前:   opentofu-sotalive
#      権限:   Account / Cloudflare Pages      / Edit
#              Account / Workers KV Storage    / Edit
#              Zone    / DNS                   / Edit
#              Zone    / Zone                  / Read
#      範囲:   Account Resources = 自分のアカウント
#              Zone Resources    = Include → Specific zone → sotalive.net
#    (Account の分は、この 2 つで足りる。足りなくなったら、plan の権限エラーを見て、トークンの権限を足す)
#    Continue to summary → Create Token。値は一度しか表示されない
#    (DNS を読むだけにするなら、DNS を Read にする。apply で DNS を管理するなら Edit が要る)
# ---------------------------------------------------------------------------
export CLOUDFLARE_API_TOKEN=""

# ---------------------------------------------------------------------------
# 3. R2 のアクセスキー(tofu の state を置くバケット sotalive-tfstate に読み書きする)
#    取り方: ダッシュボード → R2 Object Storage → 右側の「Manage R2 API Tokens」→
#            Create API token
#      権限:   Object Read & Write
#      対象:   Apply to specific buckets only → sotalive-tfstate
#    作成後の画面に出る「Access Key ID」と「Secret Access Key」を入れる(一度しか表示されない)。
#    「Cloudflare API トークン(2.)」とは別のもの。取り違えない
# ---------------------------------------------------------------------------
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# 4. R2 の S3 互換エンドポイント(state の置き場所への URL)
#    形:   https://<1. のアカウント ID>.r2.cloudflarestorage.com
#    (R2 のバケットの設定画面の「S3 API」にも出る。末尾にバケット名は付けない)
# ---------------------------------------------------------------------------
export AWS_ENDPOINT_URL_S3=""
